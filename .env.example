# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Service auth ---
# Shared secret the Laravel API must send in the X-Engine-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty only for local dev/tests; REQUIRED in production.
ENGINE_API_KEY=

# --- Database ---
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ez

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Langfuse (LLM tracing) ---
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_BASE_URL=http://localhost:3000

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# --- Laravel gateway (ez polls it to sync price-book codes) ---
LARAVEL_API_URL=http://127.0.0.1:8001
